{
  "name": "@hop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node build-local.mjs && node --env-file=.env.local --enable-source-maps dist/local/server.mjs",
    "start": "node build-local.mjs && node --env-file=.env.local --enable-source-maps dist/local/server.mjs",
    "seed:files": "node build-local.mjs && node --env-file=.env.local dist/local/seedFiles.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.699.0",
    "@aws-sdk/client-secrets-manager": "3.699.0",
    "@aws-sdk/client-sesv2": "3.699.0",
    "@aws-sdk/client-sqs": "3.699.0",
    "@aws-sdk/s3-presigned-post": "3.699.0",
    "@aws-sdk/s3-request-presigner": "3.699.0",
    "@hono/node-server": "1.13.5",
    "@hop/core": "0.1.0",
    "@supabase/supabase-js": "2.46.1",
    "exceljs": "4.4.0",
    "hono": "4.6.8",
    "jose": "5.9.6",
    "mailparser": "3.7.1",
    "pdf-lib": "1.17.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.145",
    "@types/mailparser": "3.4.5",
    "@types/node": "22.8.6",
    "esbuild": "0.24.0",
    "tsx": "4.19.2"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
