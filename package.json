{
  "name": "hotel-owners-portal",
  "private": true,
  "version": "0.1.0",
  "description": "White-label hotel owner, investor and management company portal",
  "workspaces": [
    "packages/core",
    "services/api",
    "apps/web",
    "infra",
    "tests/integration",
    "e2e"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build -w packages/core && npm run build -w services/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit",
    "test:unit": "npm run test -w packages/core && npm run test -w services/api -- --project unit && npm run test -w infra",
    "test:integration": "npm run test -w tests/integration",
    "test:e2e": "npm run test -w e2e",
    "db:start": "bash scripts/db-start.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w services/api",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "eslint": "9.13.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.11.0",
    "prettier": "3.3.3",
    "supabase": "2.120.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vitest": "2.1.4"
  }
}
